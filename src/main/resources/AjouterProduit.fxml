<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" xmlns="http://javafx.com/javafx/23.0.1"  xmlns:fx="http://javafx.com/fxml/1" fx:controller="Project.Controllers.AjouterProduitController">

   <children>
      <!-- Image de fond -->
      <ImageView fitHeight="600.0" fitWidth="875.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/AjouterProduit.png" />
         </image>
      </ImageView>

      <!-- Labels -->
      <Text fill="WHITE" layoutX="307.0" layoutY="82.0" text="ID :">
         <font><Font name="System Bold" size="24.0" /></font>
      </Text>
      <Text fill="WHITE" layoutX="307.0" layoutY="168.0" text="Nom :">
         <font><Font name="System Bold" size="24.0" /></font>
      </Text>
      <Text fill="WHITE" layoutX="307.0" layoutY="260.0" text="Statut :">
         <font><Font name="System Bold" size="24.0" /></font>
      </Text>
      <Text fill="WHITE" layoutX="307.0" layoutY="351.0" text="Quantité :">
         <font><Font name="System Bold" size="24.0" /></font>
      </Text>

      <!-- Champs de saisie -->
      <TextField fx:id="idField" layoutX="307.0" layoutY="96.0" prefHeight="35.0" prefWidth="270.0" />
      <TextField fx:id="nomField" layoutX="307.0" layoutY="184.0" prefHeight="35.0" prefWidth="270.0" />
      <TextField fx:id="quantiteField" layoutX="307.0" layoutY="366.0" prefHeight="35.0" prefWidth="270.0" />
      <ComboBox fx:id="statusComboBox" layoutX="307.0" layoutY="275.0" prefHeight="35.0" prefWidth="270.0" promptText="Abime/Perime" style="-fx-background-color: white;" />

      <!-- Boutons -->
      <Button fx:id="ajouterButton" layoutX="307.0" layoutY="418.0"  prefWidth="130.0" style="-fx-background-color: pink; -fx-text-fill: darkblue;" text="Ajouter" />


   </children>
</AnchorPane>
