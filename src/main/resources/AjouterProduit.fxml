<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.ImageInput?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Project.Controllers.AjouterProduitController">

   <children>
      <!-- Image de fond -->
      <ImageView fitHeight="600.0" fitWidth="875.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/AjouterProduit.png" />
         </image>
      </ImageView>

      <!-- Labels -->
      <Text fill="WHITE" layoutX="313.0" layoutY="112.0" text="ID :">
         <font><Font name="System Bold" size="24.0" /></font>
      </Text>
      <Text fill="WHITE" layoutX="313.0" layoutY="194.0" text="Nom :">
         <font><Font name="System Bold" size="24.0" /></font>
      </Text>
      <Text fill="WHITE" layoutX="545.0" layoutY="111.0" text="Statut :">
         <font><Font name="System Bold" size="24.0" /></font>
      </Text>
      <Text fill="WHITE" layoutX="545.0" layoutY="193.0" text="Quantité :">
         <font><Font name="System Bold" size="24.0" /></font>
      </Text>

      <!-- Champs de saisie -->
      <TextField fx:id="idField" layoutX="314.0" layoutY="119.0" prefHeight="35.0" prefWidth="200.0" />
      <TextField fx:id="nomField" layoutX="314.0" layoutY="203.0" prefHeight="35.0" prefWidth="200.0" />
      <TextField fx:id="quantiteField" layoutX="545.0" layoutY="203.0" prefHeight="35.0" prefWidth="200.0" />
      <ComboBox fx:id="statusComboBox" layoutX="545.0" layoutY="119.0" prefHeight="35.0" prefWidth="200.0" promptText="Abimé / Périmé" style="-fx-background-color: white;" />

      <!-- Boutons -->
      <Button fx:id="ajouterButton" layoutX="382.0" layoutY="355.0" onAction="#ajouterProduit" prefHeight="25.0" prefWidth="160.0" style="-fx-background-color: #007cb2; -fx-text-fill: white;" text="Ajouter" />
      <Button layoutX="551.0" layoutY="355.0" mnemonicParsing="false" onAction="#handleAnnulerButtonAction" prefHeight="25.0" prefWidth="160.0" style="-fx-background-color: #007cb2; -fx-text-fill: white;" text="Annuler" />
      <Button fx:id="ConsulterButton" layoutX="381.0" layoutY="393.0" mnemonicParsing="false" onAction="#handleConsulterButtonAction" prefHeight="25.0" prefWidth="329.0" style="-fx-background-color: #007cb2;" text="Consulter mes produits" textFill="WHITE" />
      <Button fx:id="QuitterAjouterProduitButton" layoutX="780.0" layoutY="406.0" mnemonicParsing="false" onAction="#handleQuitterButtonAction" prefHeight="50.0" prefWidth="38.0" text="Button">
         <effect>
            <ImageInput>
               <source>
                  <Image url="@Images/iconequitter.png" />
               </source>
            </ImageInput>
         </effect>
      </Button>
      <Button fx:id="MenuAjouterProduitButton" layoutX="733.0" layoutY="407.0" mnemonicParsing="false" onAction="#handleMenuButtonAction" prefHeight="50.0" prefWidth="38.0" text="Button">
         <effect>
            <ImageInput>
               <source>
                  <Image url="@Images/iconemenu.png" />
               </source>
            </ImageInput>
         </effect>
      </Button>
      <Label layoutX="438.0" layoutY="252.0" text="Date :" textFill="WHITE">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <DatePicker fx:id="datePicker" layoutX="438.0" layoutY="288.0" prefHeight="35.0" prefWidth="200.0" promptText="01/01/2025" />


   </children>
</AnchorPane>
