<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.effect.ImageInput?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Project.Controllers.MenuController">
   <children>
      <ImageView fitHeight="500.0" fitWidth="875.0" pickOnBounds="true" preserveRatio="true">
          <image>
              <Image url="@Images/HomePage.png" />
          </image>
      </ImageView>
      <Button layoutX="504.0" layoutY="187.0" mnemonicParsing="false" onAction="#handleAjouterProduit" prefHeight="50.0" prefWidth="250.0" stylesheets="@ButtonsStyle.css" text="Ajouter un produit ">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
      <Button fx:id="ConsulterButton" layoutX="503.0" layoutY="265.0" mnemonicParsing="false" onAction="#handleConsulterMesProduits" prefHeight="50.0" prefWidth="250.0" stylesheets="@ButtonsStyle.css" text="Consulter mes produits">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
      <Button layoutX="504.0" layoutY="340.0" mnemonicParsing="false" onAction="#handleStatistiquesButtonAction" prefHeight="50.0" prefWidth="250.0" stylesheets="@ButtonsStyle.css" text="Voir Statistiques">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
      <Button fx:id="SedeconnecterMenuButton" layoutX="798.0" layoutY="427.0" mnemonicParsing="false" onAction="#handleSeDeconnecterMenu" prefHeight="50.0" prefWidth="51.0">
         <effect>
            <ImageInput>
               <source>
                  <Image url="@Images/iconequitterrose.png" />
               </source>
            </ImageInput>
         </effect>
      </Button>
   </children>
</AnchorPane>
